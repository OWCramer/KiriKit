diff --git a/plugins/DrawDeviceD3D/DrawDeviceD3D.cpp b/plugins/DrawDeviceD3D/DrawDeviceD3D.cpp
index 36174e5..2d286ff 100644
--- a/plugins/DrawDeviceD3D/DrawDeviceD3D.cpp
+++ b/plugins/DrawDeviceD3D/DrawDeviceD3D.cpp
@@ -986,6 +986,17 @@ void D3DLayer::DrawEmoteTarget(void* target)
         return;
     Device->GetBackend()->SetTarget(target);
     Device->GetBackend()->LayerSetBlend(krkrsdl3::iTVPRenderBackend::LBM_ALPHA, 1.0f, nullptr);
+    if (EmoteRect[0] >= 0)
+    {
+        // Shiori: just the drawn part (texel centres line up with the pixels).
+        const int l = EmoteRect[0], t = EmoteRect[1], r = EmoteRect[2], b = EmoteRect[3];
+        if (r <= l || b <= t)
+            return;
+        const float w1 = (float)(Device->GetWidth() - 1), h1 = (float)(Device->GetHeight() - 1);
+        Device->GetBackend()->LayerDrawRect(tex, (float)l, (float)t, (float)(r - l), (float)(b - t),
+                                            (l - 0.5f) / w1, (t - 0.5f) / h1, (r - 0.5f) / w1, (b - 0.5f) / h1);
+        return;
+    }
     Device->GetBackend()->LayerDrawRect(tex, 0, 0, (float)Device->GetWidth(), (float)Device->GetHeight());
 }
 
