+        size_t count = slots.size();
+        if (freeStack.size() < count)
+            freeStack.resize(count);
+        freeStackSize.store(freeStack.size(), std::memory_order_release);
+        for (size_t i = 0; i < count; ++i)
         {
             freeStack[i] = i;
         }
