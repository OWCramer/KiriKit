 {
     // get placed path
@@ -314,7 +316,20 @@ tjs_int TVPGetCursor(const ttstr& name)
     tjs_int* in_hash = TVPCursorTable.Find(place);
     if (in_hash)
         return *in_hash;
-    return 0;
+    // A cursor file (.cur/.ani) gets a number of its own, which a host can turn back into the
+    // file (TVPGetCursorStorage) and draw.
+    if (place.IsEmpty())
+        return 0;
+    TVPCursorStorages.push_back(place);
+    tjs_int id = TVPCursorIdBase + (tjs_int)TVPCursorStorages.size() - 1;
+    TVPCursorTable.Add(place, id);
+    return id;
+}
+ttstr TVPGetCursorStorage(tjs_int id)
+{
+    if (id < TVPCursorIdBase || id - TVPCursorIdBase >= (tjs_int)TVPCursorStorages.size())
+        return ttstr();
+    return TVPCursorStorages[id - TVPCursorIdBase];
 }
