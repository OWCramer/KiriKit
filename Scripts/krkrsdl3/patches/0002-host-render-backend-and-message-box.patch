+// A host app embedding krkrsdl3 can show message boxes in its own UI (it must return the
+// pressed button's index, or -1).
+int (*TVPHostMessageBox)(const char* text,
+                         const char* caption,
+                         const char* const* buttons,
+                         int buttonCount) = nullptr;
+
 int TVPShowSimpleMessageBox(const ttstr& text,
                             const ttstr& caption,
                             const std::vector<ttstr>& vecButtons)
 {
+    if (TVPHostMessageBox)
+    {
+        std::vector<std::string> names;
+        for (const auto& btn : vecButtons)
+            names.push_back(btn.AsStdString());
+        if (names.empty())
+            names.push_back("OK");
+        std::vector<const char*> pointers;
+        for (const auto& name : names)
+            pointers.push_back(name.c_str());
+        return TVPHostMessageBox(text.AsStdString().c_str(), caption.AsStdString().c_str(),
+                                 pointers.data(), (int)pointers.size());
+    }
     std::vector<std::string> sdlButtonTexts;
     std::vector<SDL_MessageBoxButtonData> sdlButtons;
     sdlButtons.resize(vecButtons.size());
