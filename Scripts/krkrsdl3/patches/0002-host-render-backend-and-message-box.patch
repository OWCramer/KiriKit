+// A host app embedding krkrsdl3 can supply its own render backend (and present the frames
+// itself); SDL then makes no renderer of its own.
+krkrsdl3::iTVPRenderBackend* (*TVPHostRenderBackendFactory)() = nullptr;
+
 static bool TVPInitRenderBackend()
 {
+    if (TVPHostRenderBackendFactory)
+    {
+        if (krkrsdl3::iTVPRenderBackend* hostBackend = TVPHostRenderBackendFactory())
+        {
+            krkrsdl3::TVPSetRenderBackend(hostBackend);
+            return true;
+        }
+    }
     if (false) { }
