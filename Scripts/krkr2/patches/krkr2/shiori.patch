+iTVPTexture2D *TVPShioriDecodeGraphic(const ttstr &placed, std::vector<tTVPGraphicMetaInfoPair> **meta) {
+    tTVPGraphicHandlerType *handler = TVPGetGraphicLoadHandler(TVPExtractStorageExt(placed));
+    if(!handler)
