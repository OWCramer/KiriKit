+#ifdef SHIORIKRKR
+// Shiori: in a UTF-16 Oniguruma pattern \xHH is a single byte (half a character, "too short
+// multibyte code string"). Scripts mean a character, as KiriKiri's earlier regex engine took it:
+// \xHHHH and \xHH become \x{HHHH} and \x{HH} (Ninja Girl's [\x0100-\xFFFF]).
+static void TJSShioriWidenRegExpHex(TJS::ttstr &expr) {
+    const tjs_char *p = expr.c_str();
+    std::u16string out;
+    bool changed = false;
+    auto hex = [](tjs_char c) {
+        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
+    };
+    for(size_t i = 0; p[i];) {
+        if(p[i] == '\\' && p[i + 1] == 'x' && hex(p[i + 2]) && hex(p[i + 3])) {
+            size_t n = (hex(p[i + 4]) && hex(p[i + 5])) ? 4 : 2;
+            out += u"\\x{";
+            out.append(p + i + 2, p + i + 2 + n);
+            out += u"}";
+            i += 2 + n;
+            changed = true;
+        } else if(p[i] == '\\' && p[i + 1]) {
+            out += p[i];
+            out += p[i + 1];
+            i += 2;
+        } else {
+            out += p[i++];
+        }
+    }
+    if(changed)
+        expr = TJS::ttstr(out.c_str());
+}
+#endif
+
