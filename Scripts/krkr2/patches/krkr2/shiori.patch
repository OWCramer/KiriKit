+    tTVPLoadGraphicData data;
+    data.Dest = nullptr;
+    data.ColorKey = TVP_clNone;
+    data.Type = lgtFullColor;
+    data.Name = placed;
+    data.DesW = 0;
+    data.DesH = 0;
+    data.NeedMetaInfo = true;
+    data.MetaInfo = nullptr;
+    try {
+        tTVPStreamHolder holder(placed);
+        handler->Load(handler->FormatData, (void *)&data, TVPLoadGraphic_SizeCallback,
+                      TVPLoadGraphic_ScanLineCallback, TVPLoadGraphic_MetaInfoPushCallback,
+                      holder.Get(), -1, glmNormal);
+    } catch(...) {
+        if(data.Dest)
+            data.Dest->Release();
+        delete data.MetaInfo;
+        return nullptr;
+    }
+    if(!data.Dest) {
+        delete data.MetaInfo;
+        return nullptr;
+    }
+    iTVPTexture2D *texture = TVPGetRenderManager()->CreateTexture2D(data.Dest);
+    data.Dest->Release();
